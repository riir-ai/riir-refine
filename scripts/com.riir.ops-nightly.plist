<?xml version="1.0" encoding="UTF-8"?>
<!-- Issue 044 T7 — nightly ops-dashboard refresh on the M3.
     Install:    cp scripts/com.riir.ops-nightly.plist ~/Library/LaunchAgents/
                 launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.riir.ops-nightly.plist
     Uninstall:  launchctl bootout gui/$(id -u)/com.riir.ops-nightly
     Run now:    launchctl kickstart -k gui/$(id -u)/com.riir.ops-nightly
     Status:     launchctl print gui/$(id -u)/com.riir.ops-nightly | head -20
     Log:        tail -f .benchmarks/ops_nightly.log -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.riir.ops-nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>/Users/katopz/git/riir-refine/scripts/ops_nightly.sh</string>
  </array>

  <!-- 01:23 local. Off the top of the hour so it never lands in the same
       minute as the housekeeping Worker's hourly cron. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>1</integer>
    <key>Minute</key><integer>23</integer>
  </dict>

  <!-- The laptop sleeps. Without this a missed 01:23 is simply skipped
       forever; with it, launchd runs the job once after wake. -->
  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>/Users/katopz/git/riir-refine</string>

  <!-- Nice it down: this competes with interactive agent work + cargo builds
       on the same box, and nothing about a dashboard refresh is urgent. -->
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>

  <!-- The script keeps its own timestamped log; these catch anything that
       escapes it (launchd-level failures, interpreter errors). -->
  <key>StandardOutPath</key>
  <string>/Users/katopz/git/riir-refine/.benchmarks/ops_nightly.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/katopz/git/riir-refine/.benchmarks/ops_nightly.launchd.log</string>
</dict>
</plist>
