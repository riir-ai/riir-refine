# riir-refine local credentials — the template for `.env` (gitignored, NEVER commit).
#
# Copy:  cp .env.example .env   then fill in real values.
# Consumers: `scripts/ops_nightly.sh` (sources .env), `cloudflare/housekeeping`
# + `cloudflare/dashboard` worker secrets (piped via `wrangler secret put`),
# and the `groq_first` LLM ladder (`src/groq.rs`, Issue 051).
#
# Rule for agents: values are never printed, never committed. The kat_redact
# gate (v3) blocks `.env`-shaped secret assignments in any synced payload as
# defense-in-depth, but do not rely on it — do not put real values anywhere
# but this file.

# ── Groq (Issue 051: groq-first free-tier LLM routing) ──────────────────────
# Used by: src/groq.rs / `groq_first` feature / kat_drain's provider ladder.
# Absent → pure-CF metered routing (byte-identical legacy path).
# Get: https://console.groq.com/keys
GROQ_API_KEY=

# ── Infron (Issue 106: the second free leg — llm.onerouter.pro) ────────────
# Used by: src/groq.rs / `groq_first` feature / kat_drain's provider ladder.
# Sits BETWEEN groq and the metered CF fallback: groq (fast free) → infron
# (slow free, ~33 tok/s measured) → cloudflare (paid, cap-guarded) — a
# rate-limited groq degrades to a slow free leg before it ever burns paid
# neurons.
# Same OpenAI-compatible chat-completions shape; same qwen3.8-27b family
# as the groq default (the /no_think soft switch fires on it too).
# Absent → the ladder is groq → CF (the pre-106 path, byte-identical).
# NOTE: third-party aggregator — egress stays behind the redaction gate
# + own-repo-only sync policy (same posture class as the groq leg).
INFRON_API_KEY=
# INFRON_MODEL=qwen/qwen3.8-27b:free

# ── Cloudflare ─────────────────────────────────────────────────────────────
# CLOUDFLARE_API_TOKEN — the one token wrangler uses (deploy).
#   Get: CF dashboard → My Profile → API Tokens → Create Token → Custom →
#        Account · Workers Scripts · Edit.
#   Used by: scripts/ops_nightly.sh deploy step (wrangler reads it natively).
#   Absent → wrangler falls back to your `wrangler login` OAuth.
# CLOUDFLARE_OPS_API_TOKEN — read-only REST token for Account Analytics (GraphQL) and
#   Workers AI.
#   wrangler never reads this name, so it can't hijack a deploy.
#   Get (CANNOT be minted from this machine — wrangler OAuth lacks
#   `user_tokens:edit`): … → Custom → Account · Account Analytics · Read
#   (+ Account · Workers AI · Read for the Rust CF leg — src/cf_workers_ai.rs,
#   src/groq.rs, kat_drain, fixer_regate).
#   Used by: scripts/gen_dashboard.py / ops_nightly.sh analytics, the Rust
#   Workers AI leg, and the housekeeping worker's cost collector — push it as
#   that worker's secret (Worker-side binding name stays CF_API_TOKEN (deployed
#   secret); locally it is CLOUDFLARE_OPS_API_TOKEN):
#     grep '^CLOUDFLARE_OPS_API_TOKEN=' .env | cut -d= -f2- | (cd cloudflare/housekeeping && npx wrangler secret put CF_API_TOKEN)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_OPS_API_TOKEN=

# ── Housekeeping worker read gate ──────────────────────────────────────────
# Used by: the worker's /hours /days /status /backfill auth (T9e) — must ALSO
# be pushed as a worker secret:
#   grep '^READ_TOKEN=' .env | cut -d= -f2- | \
#     (cd cloudflare/housekeeping && npx wrangler secret put READ_TOKEN)
# Generate once: openssl rand -hex 32   (64 hex chars = the sha256-digest
# compare length; the digest doubles as the fan-out memo salt).
READ_TOKEN=

# ── Optional alerting (owner-supplied, NOT yet set) ─────────────────────────
# ALERT_WEBHOOK_URL: Discord-shape webhook for cap-crossing pages (50/90/100%).
#   Without it crossings still land in KV + /status alerts_today. Push as:
#   cd cloudflare/housekeeping && npx wrangler secret put ALERT_WEBHOOK_URL
# MONTHLY_BUDGET_USD: enables the monthly container-budget alert scan.
#   cd cloudflare/housekeeping && npx wrangler secret put MONTHLY_BUDGET_USD
# ALERT_WEBHOOK_URL=
# MONTHLY_BUDGET_USD=

# ── Optional mint-anchor swap-in (Issue 045 T6 / Issue 044 T5; NOT yet set) ─
# When BOTH are pushed as housekeeping-worker secrets, the hourly cron also
# POSTs the most recent COMPLETED UTC day's neuron burn to the kat-service
# ledger (`${KAT_SERVICE_URL}/mint-anchor`, bearer KAT_MINT_TOKEN). Unset →
# inert: only the local `row.mint_anchor` is written. (Server half: riir-dapps
# kat-service mint-anchor route.)
#   cd cloudflare/housekeeping && npx wrangler secret put KAT_SERVICE_URL
#   cd cloudflare/housekeeping && npx wrangler secret put KAT_MINT_TOKEN
# KAT_SERVICE_URL=
# KAT_MINT_TOKEN=

# ── Dashboard auth (owner decision 2026-08-28: gate ships OPEN) ────────────
# DASHBOARD_TOKEN: closes the ops-dashboard auth gate (currently fails OPEN).
#   cd cloudflare/dashboard && npx wrangler secret put DASHBOARD_TOKEN
# DASHBOARD_TOKEN=

# ════════════════════════════════════════════════════════════════════════════
# Added 2026-10-21 (env-var census of src/, scripts/, cloudflare/, workflows).
# Everything below is OPTIONAL — absent = the documented default.
# ════════════════════════════════════════════════════════════════════════════

# ── Hugging Face token (present in local .env — NO reader in this repo) ────
# HF_TOKEN: a census of every text file (src/, scripts/, cloudflare/, tests/,
#   .github/) found NO reader of HF_TOKEN — riir-refine never downloads from
#   the Hub itself. It is kept here only because the local .env carries it
#   (HF tooling — `hf download` / huggingface_hub — picks it up when invoked
#   from a shell that sourced .env). Safe to omit.
#   Get: https://huggingface.co/settings/tokens → New token → type `Read`.
# HF_TOKEN=

# ── LLM ladder overrides (src/groq.rs, src/cf_workers_ai.rs) ───────────────
# GROQ_MODEL: model override for the groq leg (default qwen3.8-27b family,
#   DEFAULT_GROQ_MODEL in src/groq.rs). Precedence: explicit arg > env > default.
# GROQ_MODEL=
# CLOUDFLARE_ACCOUNT_ID: the Cloudflare account id. Read by the Rust Workers AI
#   client (`CfClient::from_env`, src/cf_workers_ai.rs) — REQUIRED for the
#   metered CF leg / bench arms A/B, which refuse with a named error when
#   either CLOUDFLARE_ACCOUNT_ID or CLOUDFLARE_OPS_API_TOKEN is unset. The housekeeping worker
#   gets it from wrangler.toml [vars], not from here.
#   Get: CF dashboard → Workers & Pages → right sidebar "Account ID"
#   (or `npx wrangler whoami`). Not a secret.
#   ⚠ For that Rust CF leg CLOUDFLARE_OPS_API_TOKEN (above) must ALSO carry
#   `Account · Workers AI · Read` — an Analytics-only token fails AI calls.
# CLOUDFLARE_ACCOUNT_ID=
# RIIR_CF_MODEL: Workers AI model id override for the metered CF leg
#   (must be in the PRICING_TABLE of src/llm_spend.rs or the client refuses).
# RIIR_CF_MODEL=
# RIIR_CF_GLM_THINKING=1 opts the GLM family back into budgeted reasoning.
# RIIR_CF_GLM_THINKING=
# KAT_LLM_DAILY_CAP_USD: daily LLM spend cap (src/llm_spend.rs).
#   Default 1.0; `0` = decline-all (safe test mode); junk → default + warning.
# KAT_LLM_DAILY_CAP_USD=1.0
# KAT_LLM_SPEND_FILE: spend-ledger file override (default: ledger under the
#   current dir's .refine/).
# KAT_LLM_SPEND_FILE=
# RIIR_LLM_COST_LEDGER: JSONL cost-ledger path for kat_drain / fixer_regate
#   runs (default <repo>/.benchmarks/llm_cost_ledger.jsonl).
# RIIR_LLM_COST_LEDGER=

# ── Hosted expert / code egress (src/hosted_expert.rs, src/code_egress.rs) ─
# RIIR_REFINE_CODE_EGRESS: consent scope for sending code snippets to a
#   remote model. Unset → every egress client refuses BEFORE opening a
#   socket. The ONLY accepted value is `snippet`. No other consent implies it.
# RIIR_REFINE_CODE_EGRESS=snippet
# RIIR_HOSTED_EXPERT_TOKEN: bearer for the hosted-expert endpoint. Optional —
#   a local/loopback expert may skip auth. Issued by whoever runs the hosted
#   tier (no public dashboard). Never echoed in errors.
# RIIR_HOSTED_EXPERT_TOKEN=

# ── KAT service client (heal binary; riir-kat crate) ────────────────────────
# RIIR_REFINE_KAT_SERVICE_URL: KAT service base URL. Precedence env >
#   <account dir>/service_url.json > built-in default (riir-kat
#   kat_service_config.rs). Empty = unset.
# RIIR_REFINE_KAT_SERVICE_URL=
# RIIR_REFINE_JOIN_ENV: `devnet` | `mainnet` — answers `join` non-interactively
#   (src/kat_join.rs). Anything else refuses (exit 2).
# RIIR_REFINE_JOIN_ENV=devnet
# RIIR_REFINE_KAT_ACCOUNT_DIR: account-dir override (default under $HOME).
# RIIR_REFINE_KAT_ACCOUNT_DIR=
# Kill switches — `0|off|false|no` disables:
#   RIIR_REFINE_KAT_METER (billing meter + charge ledger + soft gate),
#   RIIR_REFINE_KAT_GATE (the 075 soft gate only), RIIR_REFINE_KAT_LEASE.
# RIIR_REFINE_KAT_METER=0
# RIIR_REFINE_KAT_GATE=0
# RIIR_REFINE_KAT_LEASE=0
# RIIR_REFINE_KAT_PROMPT_YES=1   auto-yes the depleted-balance contribute offer
# RIIR_REFINE_KAT_METER_FILE / RIIR_REFINE_KAT_CHARGE_FILE: ledger path overrides.
# RIIR_REFINE_KAT_CRANK_TOKEN: OPERATOR-ONLY bearer for `POST /admin/crank/daily`
#   (heal wetrun / settle pass). Unset → that leg refuses. Same value as the
#   kat-service ops token (riir-dapps side; no public way to mint one).
# RIIR_REFINE_KAT_CRANK_TOKEN=

# ── Operator-only tuna admin (src/tuna_admin.rs) ───────────────────────────
# TUNA_CAN_OPENER_KEY: the 64-hex ed25519 can-opener seed. NEVER accepted on
#   the command line; absent/malformed → refuses pre-network (exit 1).
#   Get: the riir-dapps .env value or ~/.kat/tuna_can_opener_*.key contents.
# KAT_CRANK_TOKEN: the ops bearer for the same admin calls (src/tuna_admin.rs).
# TUNA_CAN_OPENER_KEY=
# KAT_CRANK_TOKEN=

# ── Vessel trust anchor (src/vessel_artifacts.rs) ──────────────────────────
# RIIR_REFINE_VESSEL_PUBKEY: 64-hex ed25519 verifying key that pins signed
#   vessel artifacts. Unset → a vessel load is unpinnable and refuses.
#   Get: printed by `reflexer sign` (riir-reflexer) when the vessel is minted.
# RIIR_REFINE_VESSEL_PUBKEY=

# ── Healer behaviour knobs (all optional) ──────────────────────────────────
# RIIR_REFINE_TRAJ_ROOT      trajectory-store root override
# RIIR_REFINE_MEMORY         fix-memory envelope path override
# RIIR_REFINE_SELF_EVOLVE=0  (or off/false/no) makes the self-evolve recorder inert
# RIIR_REFINE_UPDATE_CHECK=0 disables the update check (a `CI` env also skips it)
# RIIR_REFINE_AUTO_UPGRADE=1 applies an available upgrade automatically
# RIIR_REFINE_ESC=0          demote-only kill switch for escalation rows (exact literal)
# RIIR_REFINE_DEMONSTRABILITY=0  disarms the demonstrability gate (exact literal)
# RIIR_REFINE_YES=1          auto-confirm prompts
# RIIR_REFINE_FOOTER_COLOR   footer colour override (NO_COLOR is honoured too)
# RIIR_REFINE_AUTO_ORACLE / _FEATURES / _NO_ALL_TARGETS, RIIR_REFINE_AUTO_CORPUS,
# RIIR_REFINE_REPLAY, RIIR_REFINE_NONERGODIC, RIIR_REFINE_SUPPRESS_REVERTED,
# RIIR_REFINE_CLIPPY_DRIVER, RIIR_CLIPPY_COMPILED_FEATURES, RIIR_CLIPPY_NO_TWO_STAGE,
# RIIR_CLIPPY_NO_SET_RERANK, RIIR_CLIPPY_DIFF_ANCHOR_LAMBDA, RIIR_COLLAPSE_STORE_ROOT,
# RIIR_COLLAPSE_ENVELOPE, RIIR_REGATE_STORE_DIR, RIIR_V2EDIT_DIR, RIIR_FIXER_QUALITY_HISTORY,
# RIIR_MINE_EMIT_CLEAN — advanced/dev knobs read in src/; see the reading module.
# RIIR_REFINE_BUILD_COMMIT is a build-time stamp (build_commit.rs), not runtime config.

# ── ops_nightly.sh / gen_dashboard.py knobs ────────────────────────────────
# OPS_NIGHTLY_NO_COMMIT=1 OPS_NIGHTLY_NO_DEPLOY=1 OPS_NIGHTLY_NO_CORPUS_SYNC=1
# OPS_NIGHTLY_NO_HEALQUAL_SYNC=1 — skip the matching nightly step.
# RIIR_OPS_MAIN_WT  — deploy worktree (default ../.riir-refine-main)
# RIIR_GIT_ROOT     — sibling-repo root for the dashboard (default /Users/katopz/git)
# COVERAGE_BUDGET_S — dashboard coverage budget seconds (default 600)
# CF_BILLING_ANNIVERSARY_DAY — 1..28, billing-cycle day (default 16; the
#   housekeeping worker reads the same name from wrangler.toml [vars])

# ── Test / bench harness knobs (not runtime config) ────────────────────────
# RIIR_L4_BIN / RIIR_L4_GGUF / RIIR_L4_LORA (tests/t44_*, t51_* — skip when unset),
# BONSAI_GGUF, PERF_BENCH_FILTER, STRANGER_DRILL_*, REPLAY_E2E_*, BURN_E2E_*,
# HOTPATH_E2E_*, *_BENCH_REQUIRE_PROVENANCE, T01_*, KAT_SWEEPER_* — see the
# reading test/script header.

# ── GitHub Actions secrets (repo Settings → Secrets → Actions; NOT read from .env)
# GH_PAT               — PAT with read access to the private gist-rs/* siblings (ops_dashboard.yml)
# SIBLING_REPOS_TOKEN  — fine-grained PAT cloning the private siblings (release.yml)
# RELEASE_PAT          — fine-grained PAT publishing releases (release.yml)
# CF_API_TOKEN / CLOUDFLARE_API_TOKEN — workflow copies of the CF tokens above;
#   ops_dashboard.yml maps secret CF_API_TOKEN → env CLOUDFLARE_OPS_API_TOKEN (repo-secret
#   name kept). Never put an analytics-scoped value in CLOUDFLARE_API_TOKEN.
