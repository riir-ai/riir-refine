+    #[test]
+    fn writes_and_passthroughs_ignore_the_gate() {
+        let runtime = standalone_runtime();
+        let inner = CountingLevel::new();
+        let storage = BackoffStorage::with_policy(
+            inner.clone() as Arc<dyn Storage>,
